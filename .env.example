# Nilai yang mengandung spasi WAJIB diberi tanda kutip: berkas ini dibaca
# dengan `. ./.env` (bash) dan oleh systemd EnvironmentFile.

# Wajib — buat dengan: npm run hash-password --workspace=server
PANEL_PASSWORD_HASH=""
PANEL_SESSION_SECRET=""

# Jaringan. Jangan pernah mengikat 0.0.0.0: itu membuka terminal web ke internet.
# 127.0.0.1 bila diakses lewat `tailscale serve` (disarankan), atau IP Tailscale
# mesin ini bila ingin alamat pendek seperti http://100.x.y.z/ (butuh unit sistem
# dengan CAP_NET_BIND_SERVICE untuk port 80 — lihat docs/systemd.md).
PANEL_HOST=127.0.0.1
PANEL_PORT=4000

# Lokasi project dan metadata. Bila dibiarkan kosong, bawaannya
# ~/projects dan ~/.claude-panel/projects.json untuk user yang menjalankan panel.
# Isi dengan path absolut sungguhan bila ingin lokasi lain — jangan "/home/USER".
#PANEL_PROJECTS_ROOT="/home/namauser/projects"
#PANEL_STATE_FILE="/home/namauser/.claude-panel/projects.json"

# Perintah dan port
PANEL_CLAUDE_COMMAND="claude"
PANEL_DEFAULT_DEV_COMMAND="npm run dev"
PANEL_PORT_RANGE_START=3100
PANEL_PORT_RANGE_END=3199

# File manager
PANEL_MAX_UPLOAD_MB=100

# Sesi dan origin
PANEL_SESSION_TTL_HOURS=336
# Isi bila panel diakses lewat nama host Tailscale/Cloudflare, mis.
# https://vps.ekor-ikan.ts.net
PANEL_ALLOWED_ORIGINS=""

# Atribut Secure pada cookie sesi mengikuti protokol tiap permintaan, jadi
# mencampur akses HTTPS dan HTTP tidak melemahkan jalur HTTPS. Sakelar ini
# mematikan Secure sepenuhnya dan hanya untuk pengembangan lokal.
#PANEL_INSECURE_COOKIES=1
